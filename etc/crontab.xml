<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="comfino_process_request_queue" instance="Comfino\ComfinoGateway\Cron\ProcessRequestQueue" method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
        <job name="comfino_environment_refresh" instance="Comfino\ComfinoGateway\Cron\RefreshShopEnvironment" method="execute">
            <schedule>0 3 * * *</schedule>
        </job>
    </group>
</config>
