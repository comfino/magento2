<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Bootstrap SDK before any REST API request — controller_action_predispatch does not fire in webapi_rest area. -->
    <type name="Magento\Webapi\Controller\Rest">
        <plugin name="comfino_gateway_rest_bootstrap" type="Comfino\ComfinoGateway\Plugin\RestBootstrapPlugin"/>
    </type>
</config>
